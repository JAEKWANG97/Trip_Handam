# feed 서비스 실행에 필요한 환경변수 예시.
# 실제 값을 채운 .env 파일을 만들거나, 실행 환경(도커/젠킨스 등)에 환경변수로 주입하세요.
# (.env 파일은 절대 커밋하지 마세요.)

# MySQL (application.yml의 spring.datasource.*)
MYSQL_URL=jdbc:mysql://localhost:3306/feed_db
MYSQL_USERNAME=
MYSQL_PASSWORD=

# JWT 서명 키 (application.yml의 spring.jwt.secret)
SPRING_JWT_SECRET=
